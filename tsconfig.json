{
	// The Bun process's (src/bun), for editors and oxlint's type-aware rules: Bun's globals, and the Electrobun SDK that
	// `electrobun prepare` (bun run devkit) writes to .hutch/devkit. Its paths are .hutch/devkit/tsconfig.json's, which
	// this can't extend: that one sets baseUrl, which oxlint's TypeScript refuses. src/mainview has a tsconfig of its own.
	"compilerOptions": {
		"types": ["bun"],
		"paths": {
			"electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
			"electrobun/bun": ["./.hutch/devkit/api/sdks/main/index.ts"]
		},
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src/bun", "electrobun.config.ts"]
}
