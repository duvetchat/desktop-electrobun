# Copy to .env.development.local (gitignored) for local overrides. Don't use .env.local:
# Vite also loads it for the production build behind build:canary.

# Point the app at specific API/gateway servers. Base URLs only, no path: the app appends
# /api/... and /gateway itself. Only development mode reads these two.
# VITE_API_URL=http://localhost:8080
# VITE_WS_URL=ws://localhost:8081

# Or pick a predefined backend: andremor (default), n128, or local (compose ports 9876/8765).
# VITE_DOMAIN_TARGET_ENV=andremor
