{
	"$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"biome.json",
			"package.json",
			"scripts/**",
			"src/bun/**",
			"src/mainview/src/**",
			"src/mainview/package.json"
		],
		"experimentalScannerIgnores": [
			"**/.svelte-kit/**",
			"**/node_modules/**",
			"**/build/**",
			"**/dist/**"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"formatter": {
		"enabled": true
	},
	"assist": {
		"enabled": true
	}
}
