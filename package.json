{
  "name": "@duvet/desktop",
  "version": "1.0.0",
  "scripts": {
    "devkit": "electrobun prepare",
    "start": "electrobun prepare && bun run --cwd ./src/mainview build --mode development && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run dev\"",
    "hmr": "electrobun prepare && bun run --cwd ./src/mainview dev",
    "build:canary": "electrobun prepare && bun run --cwd ./src/mainview build && electrobun build --env=canary",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write \"src/**/*.{ts,svelte,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css,json}\""
  },
  "dependencies": {
    "@lucide/svelte": "^0.577.0",
    "concurrently": "^9.2.1",
    "electrobun": "2.0.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "^0.18.1",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3"
  }
}
