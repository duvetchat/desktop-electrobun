{
	"name": "@duvet/desktop",
	"version": "1.0.0",
	"scripts": {
		"start": "bun run --cwd ./src/mainview build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run dev\"",
		"hmr": "bun run --cwd ./src/mainview dev",
		"build:canary": "bun run --cwd ./src/mainview build && electrobun build --env=canary",
		"format": "bunx @biomejs/biome format --write .",
		"format:check": "bunx @biomejs/biome format ."
	},
	"dependencies": {
		"@lucide/svelte": "^0.577.0",
		"concurrently": "^9.2.1",
		"electrobun": "1.15.1"
	},
	"devDependencies": {
		"@types/bun": "^1.3.10",
		"typescript": "^5.9.3"
	}
}
